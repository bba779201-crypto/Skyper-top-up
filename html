ផ<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Free Other ស្បែកជើងគុណភាពល្អ</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Battambang & Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Battambang:wght@400;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Battambang', 'Poppins', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <header class="bg-gradient-to-r from-indigo-600 to-violet-600 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-4 flex flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-white text-indigo-600 p-2 rounded-xl font-bold shadow-md text-xl">👟</div>
                <div>
                    <h1 class="text-base md:text-xl font-bold tracking-wide">Free Other ស្បែកជើងគុណភាពល្អ</h1>
                    <p class="text-xs text-indigo-200">ហាងស្បែកជើងអនឡាញ</p>
                </div>
            </div>
            
            <div class="flex items-center gap-2">
                <button onclick="openAdminModal()" class="bg-white/10 hover:bg-white/25 border border-white/30 text-white px-3 py-2 rounded-xl text-xs md:text-sm font-medium transition flex items-center gap-1 shadow-sm">
                    <span>➕</span> បន្ថែម
                </button>
                <button onclick="openSettingsModal()" class="bg-white/10 hover:bg-white/25 border border-white/30 text-white p-2 rounded-xl text-sm font-medium transition shadow-sm" title="កំណត់តេលេក្រាម">
                    <span>⚙️</span>
                </button>
            </div>
        </div>
    </header>

    <section class="bg-gradient-to-b from-indigo-600 to-indigo-800 text-white py-8 px-4 shadow-inner text-center">
        <div class="max-w-2xl mx-auto">
            <span class="bg-indigo-500/50 text-indigo-100 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-2 inline-block border border-indigo-400/30">
                Quality Shoes Collection
            </span>
            <h2 class="text-2xl md:text-4xl font-extrabold mb-2 tracking-tight">Free Other ស្បែកជើងគុណភាពល្អ</h2>
            <p class="text-indigo-100 text-xs md:text-sm max-w-lg mx-auto">
                ជ្រើសរើសស្បែកជើងដែលលោកអ្នកពេញចិត្ត រួចចុចប៊ូតុងឆាតមកកាន់ Telegram ដើម្បីបញ្ជាទិញភ្លាមៗ!
            </p>
        </div>
    </section>

    <main class="flex-grow max-w-4xl mx-auto px-4 py-6 w-full">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-base md:text-lg font-bold text-slate-800 flex items-center gap-2">
                <span>✨</span> បញ្ជីស្បែកជើងសរុប
                <span id="productCount" class="text-xs bg-indigo-100 text-indigo-700 px-2.5 py-0.5 rounded-full">0</span>
            </h3>
            
            <div class="relative">
                <input type="text" id="searchInput" oninput="filterProducts()" placeholder="ស្វែងរកស្បែកជើង..." class="bg-white border border-slate-300 rounded-xl px-3 py-2 text-xs md:text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm w-40 md:w-60">
            </div>
        </div>

        <div id="productGrid" class="grid grid-cols-2 gap-3 md:gap-6">
            <!-- Products injected dynamically via JavaScript -->
        </div>

        <div id="emptyState" class="hidden text-center py-16 bg-white rounded-2xl border border-slate-200 shadow-sm my-8">
            <div class="text-4xl mb-3">📭</div>
            <h4 class="text-base font-semibold text-slate-700">មិនទាន់រកឃើញទំនិញ</h4>
            <p class="text-xs text-slate-500 mt-1">សូមព្យាយាមស្វែងរកពាក្យផ្សេង ឬបន្ថែមទំនិញថ្មី។</p>
        </div>
    </main>

    <div id="adminModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 transform transition-all">
            <div class="flex justify-between items-center mb-4 border-b pb-3">
                <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <span>➕</span> បន្ថែមស្បែកជើងថ្មី
                </h3>
                <button onclick="closeAdminModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
            </div>
            
            <form id="addProductForm" onsubmit="handleAddProduct(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">ឈ្មោះទំនិញ</label>
                    <input type="text" id="prodName" required placeholder="ឧ. ស្បែកជើងម៉ូដថ្មី..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">តម្លៃទំនិញ</label>
                    <input type="text" id="prodPrice" required value="$4.00" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">តំណរូបភាព (Image URL)</label>
                    <input type="url" id="prodImage" required placeholder="https://i.ibb.co/..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <div class="pt-2 flex gap-3">
                    <button type="button" onclick="closeAdminModal()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-xl text-sm font-semibold transition">បោះបង់</button>
                    <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-2.5 rounded-xl text-sm font-semibold shadow-lg shadow-indigo-600/30 transition">រក្សាទុក</button>
                </div>
            </form>
        </div>
    </div>

    <div id="settingsModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-6">
            <div class="flex justify-between items-center mb-4 border-b pb-3">
                <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <span>⚙️</span> កែតម្រូវ Telegram
                </h3>
                <button onclick="closeSettingsModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
            </div>
            <form onsubmit="handleSaveSettings(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Telegram Username (ដោយគ្មាន @)</label>
                    <input type="text" id="telegramUsernameInput" required placeholder="ឧ. Rara12234" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                <div class="pt-2 flex gap-3">
                    <button type="button" onclick="closeSettingsModal()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-xl text-sm font-semibold">បោះបង់</button>
                    <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-2.5 rounded-xl text-sm font-semibold shadow-md">រក្សាទុក</button>
                </div>
            </form>
        </div>
    </div>

    <footer class="bg-slate-900 text-slate-400 py-6 px-4 text-center mt-auto border-t border-slate-800">
        <div class="max-w-4xl mx-auto flex flex-col items-center justify-center gap-1">
            <p class="text-xs md:text-sm font-medium text-slate-300">Free Other ស្បែកជើងគុណភាពល្អ © 2026 - រក្សាសិទ្ធិគ្រប់យ៉ាង</p>
            <p class="text-[11px] text-slate-500">ហាងលក់ស្បែកជើងអនឡាញ ទំនាក់ទំនងតាមតេលេក្រាម</p>
        </div>
    </footer>

    <script>
        const initialProducts = [
            { id: 1, name: "ស្បែកជើងម៉ូដទី ១", price: "$4.00", image: "https://i.ibb.co/fV6q5vkY/img1.jpg" },
            { id: 2, name: "ស្បែកជើងម៉ូដទី ២", price: "$4.00", image: "https://i.ibb.co/27Z6ZpGF/img2.jpg" },
            { id: 3, name: "ស្បែកជើងម៉ូដទី ៣", price: "$4.00", image: "https://i.ibb.co/pvyZBNP4/img3.jpg" },
            { id: 4, name: "ស្បែកជើងម៉ូដទី ៤", price: "$4.00", image: "https://i.ibb.co/Hft4Fpz7/img4.jpg" },
            { id: 5, name: "ស្បែកជើងម៉ូដទី ៥", price: "$4.00", image: "https://i.ibb.co/DHWv1XBq/img5.jpg" },
            { id: 6, name: "ស្បែកជើងម៉ូដទី ៦", price: "$4.00", image: "https://i.ibb.co/FqHZ48Lk/img6.jpg" },
            { id: 7, name: "ស្បែកជើងម៉ូដទី ៧", price: "$4.00", image: "https://i.ibb.co/bMG5SCSB/img7.jpg" },
            { id: 8, name: "ស្បែកជើងម៉ូដទី ៨", price: "$4.00", image: "https://i.ibb.co/3yYD6bJ4/img8.jpg" },
            { id: 9, name: "ស្បែកជើងម៉ូដទី ៩", price: "$4.00", image: "https://i.ibb.co/JW3p00bj/img9.jpg" },
            { id: 10, name: "ស្បែកជើងម៉ូដទី ១០", price: "$4.00", image: "https://i.ibb.co/7Jq9QPPY/img10.jpg" },
            { id: 11, name: "ស្បែកជើងម៉ូដទី ១១", price: "$4.00", image: "https://i.ibb.co/mrN18Tyq/img11.jpg" },
            { id: 12, name: "ស្បែកជើងម៉ូដទី ១២", price: "$4.00", image: "https://i.ibb.co/SX6Mbmq3/img12.jpg" },
            { id: 13, name: "ស្បែកជើងម៉ូដទី ១៣", price: "$4.00", image: "https://i.ibb.co/8DsCrC7R/img13.jpg" },
            { id: 14, name: "ស្បែកជើងម៉ូដទី ១៤", price: "$4.00", image: "https://i.ibb.co/N2f1yNyf/img14.jpg" },
            { id: 15, name: "ស្បែកជើងម៉ូដទី ១៥", price: "$4.00", image: "https://i.ibb.co/BVxSJGqR/img15.jpg" },
            { id: 16, name: "ស្បែកជើងម៉ូដទី ១៦", price: "$4.00", image: "https://i.ibb.co/ymx0JRxm/img16.jpg" },
            { id: 17, name: "ស្បែកជើងម៉ូដទី ១៧", price: "$4.00", image: "https://i.ibb.co/9khRP4H9/img17.jpg" },
            { id: 18, name: "ស្បែកជើងម៉ូដទី ១៨", price: "$4.00", image: "https://i.ibb.co/yF7pcD5q/img18.jpg" }
        ];

        let telegramUsername = localStorage.getItem('free_other_telegram') || 'Rara12234';
        let products = JSON.parse(localStorage.getItem('free_other_products')) || initialProducts;

        window.onload = function() {
            renderProducts(products);
            document.getElementById('telegramUsernameInput').value = telegramUsername;
        };

        function renderProducts(items) {
            const grid = document.getElementById('productGrid');
            const emptyState = document.getElementById('emptyState');
            const countBadge = document.getElementById('productCount');
            
            countBadge.innerText = items.length;
            grid.innerHTML = '';

            if (items.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            items.forEach(product => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col overflow-hidden group";
                
                const msg = encodeURIComponent(`សួស្តី! ខ្ញុំចង់ទិញស្បែកជើង: ${product.name} តម្លៃ ${product.price}`);
                const tgLink = `https://t.me/${telegramUsername}?text=${msg}`;

                card.innerHTML = `
                    <div class="relative overflow-hidden aspect-square bg-slate-100">
                        <img src="${product.image}" alt="${product.name}" onerror="this.src='https://placehold.co/400x400/e2e8f0/64748b?text=Image+Error'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    </div>
                    <div class="p-3 flex flex-col flex-grow justify-between">
                        <div>
                            <h4 class="font-bold text-slate-800 text-xs md:text-sm mb-1 line-clamp-2">${product.name}</h4>
                            <div class="text-indigo-600 font-extrabold text-sm md:text-base mb-3">${product.price}</div>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <a href="${tgLink}" target="_blank" class="flex-1 bg-sky-500 hover:bg-sky-600 text-white py-2 px-2 rounded-lg text-[11px] md:text-xs font-bold flex items-center justify-center gap-1 shadow-sm transition-all">
                                <span>💬</span> ឆាតតេលេក្រាម
                            </a>
                            <button onclick="deleteProduct(${product.id})" title="លុប" class="bg-rose-50 hover:bg-rose-100 text-rose-600 p-2 rounded-lg transition">
                                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function openAdminModal() { document.getElementById('adminModal').classList.remove('hidden'); }
        function closeAdminModal() { document.getElementById('adminModal').classList.add('hidden'); document.getElementById('addProductForm').reset(); }
        function openSettingsModal() { document.getElementById('settingsModal').classList.remove('hidden'); }
        function closeSettingsModal() { document.getElementById('settingsModal').classList.add('hidden'); }

        function handleAddProduct(e) {
            e.preventDefault();
            const newProduct = {
                id: Date.now(),
                name: document.getElementById('prodName').value,
                price: document.getElementById('prodPrice').value,
                image: document.getElementById('prodImage').value
            };
            products.unshift(newProduct);
            localStorage.setItem('free_other_products', JSON.stringify(products));
            renderProducts(products);
            closeAdminModal();
        }

        function deleteProduct(id) {
            if (confirm("តើអ្នកពិតជាចង់លុបទំនិញនេះមែនទេ?")) {
                products = products.filter(p => p.id !== id);
                localStorage.setItem('free_other_products', JSON.stringify(products));
                renderProducts(products);
            }
        }

        function handleSaveSettings(e) {
            e.preventDefault();
            telegramUsername = document.getElementById('telegramUsernameInput').value.trim().replace('@', '');
            localStorage.setItem('free_other_telegram', telegramUsername);
            closeSettingsModal();
            renderProducts(products);
            alert("បានរក្សាទុក Telegram Username ដោយជោគជ័យ!");
        }

        function filterProducts() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const filtered = products.filter(p => p.name.toLowerCase().includes(query) || p.price.toLowerCase().includes(query));
            renderProducts(filtered);
        }
    </script>
</body>
</html>
